# Copy to .env and adjust as needed. All values have working local defaults.

# Repo root; defaults to the parent of the app/ directory.
# Set this on EC2 if the checkout lives somewhere else, e.g.:
# REC_SYS_BASE_DIR=/home/ec2-user/realtime-rec-system
REC_SYS_BASE_DIR=

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=user-events

# Comma-separated list of origins allowed to call the API (the frontend dev
# server runs on 5173 by default).
CORS_ORIGINS=http://localhost:5173
